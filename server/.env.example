# ── Kryptus Server Environment Variables ──

# Server port
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/kryptus
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kryptus?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/kryptus

# JWT configuration
# IMPORTANT: Change JWT_SECRET to a cryptographically random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRY=15m
REFRESH_EXPIRY_DAYS=7

# Client URL for CORS (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
